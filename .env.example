ES_HOST=http://localhost:9200
ES_INDEX=podcast_clips
POSTGRES_USER=podcast
POSTGRES_PASSWORD=podcast
POSTGRES_DB=podcasts
POSTGRES_DSN=postgresql://podcast:podcast@localhost:5432/podcasts
REDIS_URL=redis://localhost:6379/0
CLIP_DURATION_DEFAULT=120
CLIP_OVERLAP=60
API_PORT=8000

# Optional RAG (Stage 2: BM25 evidence only; no provider calls).
# Python reads process environment variables. Export these or start Uvicorn
# with --env-file .env. Restart the API after changing settings.
# Absent/false disables RAG. true/1/yes/on enable it (case-insensitive);
# other values disable it without affecting existing search startup.
RAG_ENABLED=false
# Optional server-only generation settings; retrieval needs none of these.
# Answers remain null: llm_not_configured when missing, not_implemented when set.
# Keep real keys in the local ignored .env or process environment only.
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=

# One server-configured index only; source URLs cannot choose another index.
RAG_SOURCE_INDEX=podcast_clips
# Candidate range 1-200; source range 1-20; bytes range 1-64000.
# Invalid values fall back to these defaults without blocking search startup.
RAG_CANDIDATE_LIMIT=30
RAG_MAX_SOURCES=6
# Sum of full transcript UTF-8 bytes, not a model-token guarantee.
# Oversized clips are skipped, never truncated; no tokenizer dependency.
RAG_CONTEXT_MAX_BYTES=16000
