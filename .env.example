ES_HOST=http://localhost:9200
ES_INDEX=podcast_clips
POSTGRES_USER=podcast
POSTGRES_PASSWORD=podcast
POSTGRES_DB=podcasts
POSTGRES_DSN=postgresql://podcast:podcast@localhost:5432/podcasts
REDIS_URL=redis://localhost:6379/0
CLIP_DURATION_DEFAULT=120
CLIP_OVERLAP=60
API_PORT=8000

# Optional RAG (Stage 3: BM25 evidence plus optional Groq generation).
# Python reads process environment variables. Export these or start Uvicorn
# with --env-file .env. Restart the API after changing settings.
# Absent/false disables RAG. true/1/yes/on enable it (case-insensitive);
# other values disable it without affecting existing search startup.
RAG_ENABLED=false
# Stage 7: bm25 remains default; hybrid adds Gemini query embeddings + kNN + RRF.
# Invalid modes fall back to bm25. Hybrid failures safely retain BM25 evidence.
RAG_RETRIEVAL_MODE=bm25
# Optional server-only generation settings; retrieval needs none of these.
# Set provider=groq and select a strict Structured Outputs-compatible Groq model.
# Live-validated model: openai/gpt-oss-20b; model selection remains configurable.
# With missing settings, evidence still works and answers remain null.
# Keep real keys in the local ignored .env or process environment only.
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=

# One server-configured index only; source URLs cannot choose another index.
RAG_SOURCE_INDEX=podcast_clips
# Candidate range 1-200; source range 1-20; bytes range 1-64000.
# Invalid values fall back to these defaults without blocking search startup.
RAG_CANDIDATE_LIMIT=30
RAG_MAX_SOURCES=6
# Sum of full transcript UTF-8 bytes, not a model-token guarantee.
# Oversized clips are skipped, never truncated; no tokenizer dependency.
RAG_CONTEXT_MAX_BYTES=16000

# Total estimated model budget: instructions + question + evidence/metadata
# + framing margin + reserved output. One UTF-8 byte counts as one estimated
# token; not an exact tokenizer guarantee. Set within the chosen model limit.
RAG_CONTEXT_MAX_TOKENS=8000
RAG_MAX_OUTPUT_TOKENS=1600
# Whole-generation deadline in seconds; no automatic retries.
RAG_LLM_TIMEOUT_SECONDS=20
# 8000 / 1600 / 20 are live-validated starting values for this project,
# not universal optimal settings. Without an explicit output setting, code defaults to 800.

# Stage 5: generation-only Redis cache, separate from search. BM25 always runs.
# Valid answers/model abstentions only; failures are not cached. Redis fails open.
# 15 minutes by default; 0 disables caching. cached=true identifies generation hits.
RAG_ANSWER_CACHE_TTL_SECONDS=900

# Optional Gemini vector preparation and Stage 7 hybrid query embeddings.
# /ask remains BM25 unless RAG_RETRIEVAL_MODE=hybrid is explicitly selected.
# The key is server/local environment only. Fake remains available for tests only.
RAG_VECTOR_INDEX=podcast_rag_v1
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_REVISION=v1
RAG_EMBEDDING_TIMEOUT_SECONDS=20
